# Clerk (use production keys on Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# JWT template name configured in the Clerk dashboard (Imadeo API).
# Required in production — there is no production fallback. Set this in Vercel.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=jwt-imadeo-dev

# Backend API origin.
# Required in production (Vercel): e.g. https://api.imadeo.in
# Local fallback is http://localhost:8000 when NODE_ENV is not production.
NEXT_PUBLIC_API_URL=http://localhost:8000
